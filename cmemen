
import copy

class Memento: #@author: Timothé Gaudin
    def __init__(self, grille, tour):
        # On fait une copie profonde de la grille pour ne pas partager les références des pièces
        self._grille = copy.deepcopy(grille)
        self._tour = tour

    def obtenir_etat(self):
        return self._grille, self._tour
